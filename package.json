{
  "name": "@fysh925/mcp-server-fanqie",
  "version": "0.2.0-dev.4",
  "description": "番茄 MCP 与 Skill：小说、漫画、短剧分类搜索，书评正文，小说目录与网站正文",
  "private": false,
  "type": "module",
  "license": "MIT",
  "author": "fysh1010 <2930234806@qq.com>",
  "homepage": "https://github.com/fysh1010/mcp-server-fanqie#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fysh1010/mcp-server-fanqie.git"
  },
  "bugs": {
    "url": "https://github.com/fysh1010/mcp-server-fanqie/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "fanqie",
    "tomato-novel",
    "番茄小说",
    "novel",
    "小说",
    "claude",
    "cursor",
    "llm",
    "ai"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "mcp-server-fanqie": "./server/mcp-local.mjs",
    "fanqie-local-api": "./server/index.mjs",
    "fanqie": "./server/cli.mjs"
  },
  "files": [
    "build",
    "server/*.mjs",
    "!server/*.test.mjs",
    "!server/*probe.mjs",
    "server/*.md",
    "skills/fanqie-novel/",
    "scripts/*.mjs",
    "docs/USAGE.md",
    "licenses/",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-skill.mjs && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js",
    "start": "node server/mcp-local.mjs",
    "start:api": "node server/index.mjs",
    "start:remote": "node build/index.js",
    "test": "node --test server/*.test.mjs",
    "cli": "node server/cli.mjs",
    "install:skill": "node scripts/install-skill.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "0.6.0",
    "axios": "^1.6.2",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "typescript": "^5.3.3"
  }
}
